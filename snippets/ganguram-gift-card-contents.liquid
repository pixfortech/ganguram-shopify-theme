{% doc %}
  Shows item names in a compact preview and quantities only when expanded.
  @param {product} product - Product with confirmed gift contents and preview lists.
{% enddoc %}
{%- assign gift_contents = product.metafields.custom.gift_contents.value -%}
{%- assign gift_preview = product.metafields.custom.gift_contents_preview.value -%}
{%- if gift_contents != blank -%}
  <details class="product-item__gift-contents">
    <summary>
      <span class="product-item__gift-heading">
        <span class="product-item__gift-label">{{ 'products.card.gift_contents' | t }}</span>
        <span class="product-item__gift-toggle" aria-hidden="true"></span>
      </span>
      {%- if gift_preview != blank -%}
        <span class="product-item__gift-preview">{{ gift_preview | join: ' · ' | escape }}</span>
      {%- endif -%}
    </summary>
    <ul class="product-item__gift-list" role="list">
      {%- for item in gift_contents -%}<li>{{ item | escape }}</li>{%- endfor -%}
    </ul>
  </details>
{%- endif -%}
