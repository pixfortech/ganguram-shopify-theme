<section class="ggb-product-story" aria-labelledby="GiftReveal-{{ section.id }}">
  <div class="ggb-intro"><p class="ggb-eyebrow">GANGURAM · THE ART OF GIFTING</p><h2 id="GiftReveal-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p>Five favourites. Thirty-three little celebrations.<br>Lift the magnetic lid and discover the selection.</p></div>
  {% render 'ganguram-magnetic-box', product: product %}
  <p class="ggb-photography-note">Styled presentation of the selection. Handmade shapes, garnish and arrangement may vary; the listed contents and quantities define your gift.</p>
</section>
{% schema %}
{"name":"Magnetic gift reveal","tag":"div","settings":[{"type":"text","id":"heading","label":"Heading","default":"A gift worth opening."}],"presets":[{"name":"Magnetic gift reveal"}],"enabled_on":{"templates":["product"]}}
{% endschema %}
